# ─────────────────────────────────────────────────────────────────────────────
# MONESPACE.CPI — variables de build du frontend
#
# Vite ne lit QUE les variables préfixées « VITE_ ». Elles sont inlinées dans le
# bundle au build : tout ce qui figure ici est PUBLIC et lisible par n'importe
# quel visiteur. N'y mettez jamais de secret (clé d'API, mot de passe, jeton).
#
# Fichiers lus, par priorité croissante :
#   .env  →  .env.<mode>  →  .env.local  →  .env.<mode>.local
# `npm run dev` = mode development · `npm run build` = mode production.
#
# .env.development et .env.production sont versionnés (aucun secret).
# .env.local sert aux réglages propres à votre machine — il est ignoré par git.
# ─────────────────────────────────────────────────────────────────────────────

# Base absolue de l'API Laravel, SANS le suffixe /api (le client l'ajoute).
#
# Vide  ⇒ appels relatifs sur « /api », donc même origine que le site : c'est le
#          cas en développement (le proxy Vite relaie) et si un jour l'API est
#          servie derrière le même domaine que le frontend.
# Rempli ⇒ appels inter-origine. Le backend doit alors autoriser explicitement
#          l'origine du site via FRONTEND_URL (voir config/cors.php).
VITE_API_URL=

# Backend visé par le proxy du serveur de développement. Sans effet au build.
VITE_API_PROXY_TARGET=http://localhost:8000

# Adresse publique du site : URL canonique, Open Graph, données structurées,
# sitemap.xml, robots.txt. Doit correspondre au domaine réellement servi.
VITE_SITE_URL=https://monespace.cpi.sn

# Identifiant de mesure Google Analytics (« G-XXXXXXXXXX »).
# Vide ⇒ aucun script de suivi n'est injecté, aucune requête vers Google.
VITE_GTAG_ID=

# ─── Coordonnées du support (écran « Support » de l'espace client) ──────────
# Laisser VIDE tant que la vraie valeur n'est pas connue : la carte s'affiche
# alors « Bientôt disponible » et n'est pas cliquable — jamais un numéro factice.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=support@cpi.sn
