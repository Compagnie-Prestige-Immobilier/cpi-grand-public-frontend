# Développement — utilisé automatiquement par `npm run dev` (mode development).
#
# VITE_API_URL reste VIDE : le client appelle « /api » en relatif et le proxy
# Vite relaie vers VITE_API_PROXY_TARGET. Le navigateur ne voit qu'une seule
# origine, donc aucune question de CORS ne se pose en local.
VITE_API_URL=

# Backend local. Démarrez-le avec `php artisan serve --host=0.0.0.0` pour qu'il
# réponde aussi bien sur localhost que sur l'adresse réseau de la machine.
# Pour viser un autre hôte sans modifier ce fichier : créez .env.local
# (ignoré par git) avec votre propre VITE_API_PROXY_TARGET.
VITE_API_PROXY_TARGET=http://localhost:8000

VITE_SITE_URL=http://localhost:5173
VITE_GTAG_ID=

# ─── Coordonnées du support (écran « Support » de l'espace client) ──────────
# Laisser VIDE tant que la vraie valeur n'est pas connue : la carte s'affiche
# alors « Bientôt disponible » et n'est pas cliquable — jamais un numéro factice.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=support@cpi.sn
