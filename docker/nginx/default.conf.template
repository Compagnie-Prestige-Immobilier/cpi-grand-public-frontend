# =============================================================================
# MONESPACE.CPI — server block (template)
#
# ${API_ORIGIN} est substitué au démarrage du conteneur (envsubst de l'image
# nginx officielle). Les variables nginx ($uri, $host…) ne sont PAS touchées :
# seuls les noms présents dans l'environnement le sont.
#
# TLS, HSTS et le nom public appartiennent au proxy TLS en amont — ici on ne
# parle que HTTP sur :80.
# =============================================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;

    # --- En-têtes de sécurité ------------------------------------------------
    # `always` pour qu'ils survivent aussi aux réponses d'erreur.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP pragmatique pour cette SPA :
    #  - style-src 'unsafe-inline' : l'app utilise massivement des styles inline (props React)
    #  - fonts.googleapis/gstatic  : polices (préconnexions dans index.html)
    #  - img-src https:            : R2 (URL signées), avatars Google, visuels Unsplash
    #  - googletagmanager/analytics: inertes tant que VITE_GTAG_ID n'est pas défini au build
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.google-analytics.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # --- Santé ---------------------------------------------------------------
    # Répondu par nginx lui-même : valide le rendu de la config au démarrage.
    location = /up {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # --- API -----------------------------------------------------------------
    # Même origine pour le navigateur : pas de CORS en production, pas de
    # préflight, et la CSP `connect-src 'self'` reste valable.
    #
    # L'upstream est joint par son URL PUBLIQUE (${API_ORIGIN}) : les deux stacks
    # n'ont aucun réseau Docker en commun et restent déployables séparément.
    location /api/ {
        proxy_pass ${API_ORIGIN};
        proxy_http_version 1.1;

        # Host = nom PUBLIC de l'API, surtout pas $host.
        #
        # En amont, le proxy TLS route sur le Host : lui renvoyer
        # « monespace.cpi.sn » le ferait retomber sur le routeur du frontend —
        # donc sur ce même conteneur, en boucle, jusqu'à épuisement.
        # C'est aussi ce nom qui sert de SNI à la poignée de main TLS.
        proxy_set_header Host ${API_HOST};
        proxy_ssl_server_name on;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";

        # Aligné sur le backend : fastcgi_read_timeout 60s côté API.
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;   # le corps d'un dépôt de 50 Mo part vers l'API
        proxy_read_timeout 65s;

        # Réponses JSON : tout tient en mémoire, rien ne touche le disque.
        proxy_buffering on;
        proxy_buffer_size 32k;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 32k;
    }

    # --- Assets fingerprintés (Vite) -----------------------------------------
    # Le hash change à chaque build : cache immuable d'un an sans risque.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # --- Statique à la racine (favicons, manifest, robots, sitemap, llms.txt) -
    # Pas de hash dans les noms : cache court pour que les mises à jour passent.
    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|txt|xml|webmanifest)$ {
        expires 1h;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # Jamais de dotfiles, même déposés dans dist/ par erreur.
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # --- SPA -----------------------------------------------------------------
    # index.html ne doit JAMAIS être mis en cache : c'est lui qui référence les
    # assets fingerprintés du build courant — un index périmé casse le déploiement.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
